{
  "name": "huellas-a-casa",
  "version": "1.0.0",
  "description": "Plataforma comunitaria de emergencia para reencuentro de mascotas",
  "type": "module",
  "scripts": {
    "test": "node tests/huellas.test.mjs",
    "test:rules": "JAVA_HOME=/opt/homebrew/opt/openjdk PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only firestore,storage \"node tests/storage-rules.test.mjs\"",
    "test:rules:firestore": "JAVA_HOME=/opt/homebrew/opt/openjdk PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only firestore \"node tests/firestore-rules.test.mjs\""
  },
  "keywords": [
    "mascotas",
    "emergencia",
    "cali",
    "colombia"
  ],
  "author": "Huellas a Casa",
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  }
}
